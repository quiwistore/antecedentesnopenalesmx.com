<div class="ad" data-ad>
<ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-7716650869618779" data-ad-slot="0000000000" data-ad-format="auto" data-full-width-responsive="true"></ins>
<script is:inline>
(function(){
  try{(adsbygoogle=window.adsbygoogle||[]).push({});}catch(e){}
  var box=document.currentScript.closest('[data-ad]');
  function chk(){
    var ins=box&&box.querySelector('ins.adsbygoogle');
    if(!ins||ins.getAttribute('data-ad-status')==='unfilled'||ins.offsetHeight<10){box.style.display='none';}
  }
  setTimeout(chk,1500);
})();
</script>
</div>
