---
import L from '../data/legal.json';
import LS from '../data/contacto.json';
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
---
<Base title="Aviso de Privacidad — Antecedentes No Penales MX" description="Aviso de privacidad de Antecedentes No Penales MX." path="/privacidad/">
<div class="hero"><div class="wrap"><h1>Aviso de privacidad</h1></div></div>
<main class="wrap">
<Crumbs name="Privacidad" />
<Fragment set:html={L['privacy'].html.replaceAll('{{EMAIL}}', LS.email)} />
</main>
</Base>
