---
import L from '../data/legal.json';
import LS from '../data/contacto.json';
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
---
<Base title="Términos y Condiciones — Antecedentes No Penales MX" description="Términos y condiciones de uso de Antecedentes No Penales MX." path="/terminos/">
<div class="hero"><div class="wrap"><h1>Términos y condiciones</h1></div></div>
<main class="wrap">
<Crumbs name="Términos" />
<Fragment set:html={L['terms'].html.replaceAll('{{EMAIL}}', LS.email)} />
</main>
</Base>
